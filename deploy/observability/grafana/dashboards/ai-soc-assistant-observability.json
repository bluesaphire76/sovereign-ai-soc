{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Assistant service overview",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Gateway metrics target",
      "description": "Prometheus can reach the read-only inference metrics bridge.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 1, "w": 4, "h": 4 },
      "targets": [
        { "expr": "up{job=\"ai-inference-gateway\"}", "legendFormat": "gateway scrape", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Gateway runtime",
      "description": "The standard-profile inference runtime is ready for generation.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 4, "y": 1, "w": 4, "h": 4 },
      "targets": [
        { "expr": "ai_execution_gateway_ready{job=\"ai-inference-gateway\"}", "legendFormat": "runtime", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "NOT READY", "color": "red" }, "1": { "text": "READY", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Queue utilization",
      "description": "Current queued requests as a fraction of configured gateway capacity.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 8, "y": 1, "w": 4, "h": 4 },
      "targets": [
        { "expr": "ai_execution_queue_depth{job=\"ai-inference-gateway\"} / clamp_min(ai_execution_queue_capacity{job=\"ai-inference-gateway\"}, 1)", "legendFormat": "queue", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 0.5 }, { "color": "red", "value": 0.8 } ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Assistant E2E p95",
      "description": "HTTP latency from Assistant query receipt through atomic model publication or fallback.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 12, "y": 1, "w": 4, "h": 4 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(ai_soc_http_request_duration_seconds_bucket{job=\"ai-soc-api\",method=\"POST\",path=\"/assistant/query\"}[$__rate_interval])) by (le))", "legendFormat": "p95", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 20 }, { "color": "red", "value": 40 } ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Proven model publish rate",
      "description": "Share of V3 responses published from the model after validation/proof.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 16, "y": 1, "w": 4, "h": 4 },
      "targets": [
        { "expr": "sum(rate(assistant_v3_responses_total{job=\"ai-soc-api\",generation_kind=\"model\"}[$__rate_interval])) / clamp_min(sum(rate(assistant_v3_responses_total{job=\"ai-soc-api\"}[$__rate_interval])), 0.000001)", "legendFormat": "model", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 0.25 }, { "color": "green", "value": 0.6 } ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Fail-closed response rate",
      "description": "Share of V3 responses delivered as deterministic fallbacks.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 20, "y": 1, "w": 4, "h": 4 },
      "targets": [
        { "expr": "sum(rate(assistant_v3_responses_total{job=\"ai-soc-api\",generation_kind=\"deterministic_fallback\"}[$__rate_interval])) / clamp_min(sum(rate(assistant_v3_responses_total{job=\"ai-soc-api\"}[$__rate_interval])), 0.000001)", "legendFormat": "fallback", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 0.4 }, { "color": "red", "value": 0.8 } ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true }
    },
    {
      "id": 8,
      "type": "row",
      "title": "Inference gateway traffic, capacity and latency",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Gateway request outcomes",
      "description": "Generation throughput split by bounded task and gateway status.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 6, "w": 8, "h": 8 },
      "targets": [
        { "expr": "sum by (task, status) (rate(ai_execution_requests_total{job=\"ai-inference-gateway\"}[$__rate_interval]))", "legendFormat": "{{task}} / {{status}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Assistant inference latency percentiles",
      "description": "Gateway execution time for the soc_assistant task, excluding queue wait.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 8, "y": 6, "w": 8, "h": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(ai_execution_request_duration_seconds_bucket{job=\"ai-inference-gateway\",task=\"soc_assistant\"}[$__rate_interval])) by (le))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(ai_execution_request_duration_seconds_bucket{job=\"ai-inference-gateway\",task=\"soc_assistant\"}[$__rate_interval])) by (le))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum(rate(ai_execution_request_duration_seconds_bucket{job=\"ai-inference-gateway\",task=\"soc_assistant\"}[$__rate_interval])) by (le))", "legendFormat": "p99", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" }, "overrides": [] },
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Queue and active generation",
      "description": "Current queue depth, configured capacity and active single-owner generation.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 16, "y": 6, "w": 8, "h": 8 },
      "targets": [
        { "expr": "ai_execution_queue_depth{job=\"ai-inference-gateway\"}", "legendFormat": "queued", "refId": "A" },
        { "expr": "ai_execution_queue_capacity{job=\"ai-inference-gateway\"}", "legendFormat": "capacity", "refId": "B" },
        { "expr": "ai_execution_active_requests{job=\"ai-inference-gateway\"}", "legendFormat": "active", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short", "min": 0 }, "overrides": [] },
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Queue wait p95 by task",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 14, "w": 6, "h": 7 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, task) (rate(ai_execution_queue_wait_seconds_bucket{job=\"ai-inference-gateway\"}[$__rate_interval])))", "legendFormat": "{{task}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" }, "overrides": [] },
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Provider generation p95 by task",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 6, "y": 14, "w": 6, "h": 7 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, task) (rate(ai_execution_generation_duration_seconds_bucket{job=\"ai-inference-gateway\",status=\"success\"}[$__rate_interval])))", "legendFormat": "{{task}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" }, "overrides": [] },
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Assistant token throughput",
      "description": "Prompt and completion tokens per second for Assistant inference.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 12, "y": 14, "w": 6, "h": 7 },
      "targets": [
        { "expr": "sum by (direction) (rate(ai_execution_tokens_total{job=\"ai-inference-gateway\",task=\"soc_assistant\"}[$__rate_interval]))", "legendFormat": "{{direction}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Gateway safety and failure signals",
      "description": "Deadline, truncation and forbidden profile-switch activity.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 18, "y": 14, "w": 6, "h": 7 },
      "targets": [
        { "expr": "sum(rate(ai_execution_deadline_exceeded_total{job=\"ai-inference-gateway\",task=\"soc_assistant\"}[$__rate_interval]))", "legendFormat": "deadline exceeded", "refId": "A" },
        { "expr": "sum(rate(ai_execution_truncated_total{job=\"ai-inference-gateway\",task=\"soc_assistant\"}[$__rate_interval]))", "legendFormat": "truncated", "refId": "B" },
        { "expr": "sum(rate(ai_execution_profile_switch_total{job=\"ai-inference-gateway\"}[$__rate_interval]))", "legendFormat": "profile switch", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 16,
      "type": "row",
      "title": "Assistant request lifecycle",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 21, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Published response outcomes",
      "description": "Atomic publication outcome after validation and proof.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 22, "w": 8, "h": 8 },
      "targets": [
        { "expr": "sum by (generation_kind, validation_status) (rate(assistant_v3_responses_total{job=\"ai-soc-api\"}[$__rate_interval]))", "legendFormat": "{{generation_kind}} / {{validation_status}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Deterministic fallback reasons",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 8, "y": 22, "w": 8, "h": 8 },
      "targets": [
        { "expr": "sum by (reason) (rate(ai_execution_fallback_total{job=\"ai-soc-api\"}[$__rate_interval]))", "legendFormat": "{{reason}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Assistant API outcomes",
      "description": "HTTP response rate for the user-visible Assistant query endpoint.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 16, "y": 22, "w": 8, "h": 8 },
      "targets": [
        { "expr": "sum by (status_code) (rate(ai_soc_http_requests_total{job=\"ai-soc-api\",method=\"POST\",path=\"/assistant/query\"}[$__rate_interval]))", "legendFormat": "HTTP {{status_code}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Assistant end-to-end latency",
      "description": "Full API lifecycle including retrieval, one generation, proof and publication/fallback.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 30, "w": 12, "h": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(ai_soc_http_request_duration_seconds_bucket{job=\"ai-soc-api\",method=\"POST\",path=\"/assistant/query\"}[$__rate_interval])) by (le))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(ai_soc_http_request_duration_seconds_bucket{job=\"ai-soc-api\",method=\"POST\",path=\"/assistant/query\"}[$__rate_interval])) by (le))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum(rate(ai_soc_http_request_duration_seconds_bucket{job=\"ai-soc-api\",method=\"POST\",path=\"/assistant/query\"}[$__rate_interval])) by (le))", "legendFormat": "p99", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" }, "overrides": [] },
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Analytical pipeline stage p95",
      "description": "Bounded non-generative stage latency for routing, retrieval, rehydration and graph construction.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 12, "y": 30, "w": 12, "h": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(assistant_v3_stage_duration_seconds_bucket{job=\"ai-soc-api\",status=\"passed\"}[$__rate_interval])))", "legendFormat": "{{stage}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" }, "overrides": [] },
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 22,
      "type": "row",
      "title": "Semantic proof and grounding safety",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 38, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Semantic proof executions",
      "description": "Proof executions by passed, failed or unavailable status.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 39, "w": 8, "h": 8 },
      "targets": [
        { "expr": "sum by (status) (rate(assistant_v32_semantic_proof_seconds_count{job=\"ai-soc-api\"}[$__rate_interval]))", "legendFormat": "{{status}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "Proof decision reasons",
      "description": "Closed hybrid proof reasons for every proposition decision.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 8, "y": 39, "w": 8, "h": 8 },
      "targets": [
        { "expr": "sum by (reason) (rate(assistant_v32_semantic_proof_decisions_total{job=\"ai-soc-api\"}[$__rate_interval]))", "legendFormat": "{{reason}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 25,
      "type": "timeseries",
      "title": "Grounding rejection reasons",
      "description": "Fail-closed validation and semantic-proof rejection reasons.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 16, "y": 39, "w": 8, "h": 8 },
      "targets": [
        { "expr": "sum by (reason) (rate(ai_execution_grounding_rejections_total{job=\"ai-soc-api\"}[$__rate_interval]))", "legendFormat": "{{reason}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 26,
      "type": "timeseries",
      "title": "Semantic proof latency",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 47, "w": 8, "h": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(assistant_v32_semantic_proof_seconds_bucket{job=\"ai-soc-api\"}[$__rate_interval])) by (le))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(assistant_v32_semantic_proof_seconds_bucket{job=\"ai-soc-api\"}[$__rate_interval])) by (le))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum(rate(assistant_v32_semantic_proof_seconds_bucket{job=\"ai-soc-api\"}[$__rate_interval])) by (le))", "legendFormat": "p99", "refId": "C" }
