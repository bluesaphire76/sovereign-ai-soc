[Unit]
Description=Sovereign AI SOC Next.js Frontend
After=network.target ai-soc-api.service ai-soc-worker.service
Requires=ai-soc-api.service ai-soc-worker.service

[Service]
Type=simple
User=ai-soc
Group=ai-soc
WorkingDirectory=/opt/sovereign-ai-soc/frontend
EnvironmentFile=-/opt/sovereign-ai-soc/.env
Environment="NODE_ENV=production"
Environment="PORT=3000"
ExecStart=/usr/bin/env npm run start -- -H 0.0.0.0 -p 3000
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
